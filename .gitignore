probe_results.jsonl
usage.jsonl
usage.sqlite3*
# 日志与缓存
logs/
__pycache__/
*.pyc
# 备份文件
*.bak.*
.DS_Store
# 本地临时证据/截图工作区（不进公开树）
docs/_tmp*
